# ==========================================
# ALPHA LC - Telegram Bot & WebApp Sozlamalari
# ==========================================

# 1. Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=8976693690:AAH...your_bot_token_here...

# 2. Asosiy Adminlar Telegram ID raqamlari (vergul bilan ajratilgan)
ADMINS=1435473812

# 3. PostgreSQL Ma'lumotlar Bazasi
DB_USER=postgres
DB_PASS=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=english_center

# 3.1. To'liq ulanish URL lari (ixtiyoriy, agar ko'rsatilmasa yuqoridagi parametrlardan avtomatik yig'iladi):
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password_here@127.0.0.1:5432/english_center
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:your_secure_db_password_here@127.0.0.1:5432/english_center

# 4. Telegram WebApp Domeni (Production domen yoki HTTPS havola)
WEBAPP_URL=https://your-domain.com

# 5. Dasturchi / Test rejimi (True/False)
DEV_MODE=False

# 6. Sun'iy Intellekt Kalitlari (AI PDF Test Generator uchun - ixtiyoriy)
GEMINI_API_KEY=
OPENAI_API_KEY=